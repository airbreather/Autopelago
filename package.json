{
  "name": "autopelago",
  "version": "0.0.0",
  "builders": "./builders.json",
  "web-types": "./web-types.json",
  "browserslist": [
    "baseline widely available on 2026-05-07"
  ],
  "scripts": {
    "ng": "ng",
    "bake-color-masks": "bun run src/generate-color-masks.ts > src/app/utils/color-masks.json",
    "bake-game-data": "yq . AutopelagoDefinitions.yml --output-format json --indent 0 > src/app/data/baked.json",
    "bake-data": "$npm_execpath run bake-color-masks && $npm_execpath run bake-game-data",
    "postinstall": "$npm_execpath run bake-data",
    "prestart": "$npm_execpath run bake-data",
    "prebuild": "$npm_execpath run bake-data",
    "prewatch": "$npm_execpath run bake-data",
    "pretest": "$npm_execpath run bake-data",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test",
    "stamp-version": "jq -R -s 'split(\"\n\") | { \"version\": .[0], \"commit\": .[1], \"timestamp\": .[2] }' <(echo $GITHUB_REF_NAME) <(echo $GITHUB_SHA) <(date --utc --rfc-3339=seconds) >src/version-info.json",
    "prerelease": "$npm_execpath run stamp-version",
    "release": "$npm_execpath run build"
  },
  "private": true,
  "dependencies": {
    "@airbreather/archipelago.js": "2.2.1",
    "@angular/cdk": "22.2.0",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@bitarray/typedarray": "^1.1.3",
    "@ctrl/tinycolor": "^4.2.1",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@openng/ngx-toastr": "^1.1.1",
    "angular-split": "^20.0.0",
    "immutable": "^5.1.9",
    "node-forge": "^1.4.0",
    "normalize.css": "^8.0.1",
    "pure-rand": "^8.4.2",
    "regexp.escape": "^2.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "tslib": "^2.8.1",
    "yocto-queue": "^1.2.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.2",
    "@types/node-forge": "^1.3.14",
    "@types/regexp.escape": "^2.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "sharp"
  ]
}
